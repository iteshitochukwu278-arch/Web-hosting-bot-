ADMIN_PASSWORD=marvel001

# --- Cloud storage (MongoDB Atlas) - see README.md ---
# Host bot data + all customer files are saved here, so redeploys never wipe anything.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=hostbot
# --- Customer database pool (all optional, up to 20 servers, any mix of engines) ---
# The engine is detected from the URL. ROUND ROBIN: customer 1 -> CUSTOMER_DB_1, customer 2 -> CUSTOMER_DB_2, ...
# after the last one it starts again at CUSTOMER_DB_1. Keep these SEPARATE from MONGO_URI above.
# MongoDB Atlas (free, no card):
CUSTOMER_DB_1=mongodb+srv://newupdateforfb29_db_user40onCOsp3t7J1X6h@cluster0.cb1qh9p.mongodb.net/?retryWrites=true&w=majority
# MySQL (admin login that can CREATE USER / GRANT; URL-encode special characters; add ?ssl=true if needed):
CUSTOMER_DB_2=mysql://avnadmin:AVNS_VK2HmIPVTiKiEnG944v@mysql-7e3c0fe-newupdateforfb29-251d.l.aivencloud.com:13822/defaultdb?ssl-mode=true
# PostgreSQL - Neon (free, no card), Supabase, CockroachDB, Aiven ... (admin login that can CREATE DATABASE / ROLE):
CUSTOMER_DB_3=postgresql://neondb_owner:npg_ZD6UOgJe8jiY@ep-small-glitter-bewrt6c4-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
CUSTOMER_DB_4=
CUSTOMER_DB_5=
# Max customers per server (0 = unlimited, which keeps the circle going forever). Optional per engine:
# MONGO_MAX_PER_SERVER / MYSQL_MAX_PER_SERVER / POSTGRES_MAX_PER_SERVER
DB_MAX_PER_SERVER=5
# Any long random text. Used to derive customers' MySQL passwords. Do not change it later.
DB_SECRET=long-random-text
# Max size of a single customer file saved to the cloud (MB)
PERSIST_MAX_FILE_MB=25
